# ─────────────────────────────────────────────────────────────
# G4M37Z Communities — environment variables
# Copy this file to `.env.local` for local dev, and set the same
# keys in the Vercel dashboard for production.
# NEVER commit `.env.local` or `.env` to git — already in .gitignore.
# ─────────────────────────────────────────────────────────────

# Supabase — project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase — anon / publishable key. Safe to expose to the browser.
# Used by the client and server to read public content + handle auth.
# (Project Settings → API → Project API keys → `anon` `public`)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service_role key. SERVER-SIDE ONLY.
# ⚠️  NEVER COMMIT THIS. NEVER EXPOSE TO THE BROWSER.
# ⚠️  This key CANNOT run DDL like CREATE TABLE / ALTER TABLE.
#     Schema changes must be pasted into the Supabase SQL Editor.
# (Project Settings → API → Project API keys → `service_role`)
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployed site. Used to build absolute URLs
# (auth email links, OpenGraph metadata, etc.).
#   Local dev:  http://localhost:3000
#   Production: https://<your-project>.vercel.app
# Set this AFTER the first Vercel deploy once you know the real URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Rate limiting (GAP-RATE-01)
# ─────────────────────────────────────────────────────────────
# Backend order: the shared Vercel KV (Upstash) store is used automatically
# when BOTH KV_REST_API_URL and KV_REST_API_TOKEN are set; otherwise an
# in-process fixed-window limiter is active per instance (the default, so
# limits are never dormant). Force a backend with:
#   memory — always use the in-process limiter
#   kv     — require KV (fails open if unconfigured)
RATE_LIMIT_BACKEND=

# Shared rate-limit store (Vercel KV / Upstash REST). Set both to scale
# counters beyond a single instance and to share windows across instances.
KV_REST_API_URL=
KV_REST_API_TOKEN=
